{
  "app_name": "invoice_ops",
  "app_title": "Invoice Ops",
  "domain": [
    {
      "name": "Tenant",
      "title": "Tenant",
      "intent": "Tenant root — a customer company processing supplier invoices",
      "lifecycle_states": [
        "active",
        "suspended"
      ],
      "relationships": []
    },
    {
      "name": "User",
      "title": "User",
      "intent": "Domain user — carries tenant_id for current_user.tenant_id resolution",
      "lifecycle_states": [],
      "relationships": [
        {
          "field": "tenant_id",
          "target": "Tenant",
          "target_title": "Tenant",
          "required": true
        }
      ]
    },
    {
      "name": "Supplier",
      "title": "Supplier",
      "intent": "A supplier that bills a tenant",
      "lifecycle_states": [],
      "relationships": [
        {
          "field": "tenant_id",
          "target": "Tenant",
          "target_title": "Tenant",
          "required": true
        }
      ]
    },
    {
      "name": "SupplierBankAccount",
      "title": "Supplier Bank Account",
      "intent": "Banking details for a supplier — isolated for stricter access control",
      "lifecycle_states": [],
      "relationships": [
        {
          "field": "tenant_id",
          "target": "Tenant",
          "target_title": "Tenant",
          "required": true
        },
        {
          "field": "supplier",
          "target": "Supplier",
          "target_title": "Supplier",
          "required": true
        }
      ]
    },
    {
      "name": "Invoice",
      "title": "Invoice",
      "intent": "Supplier invoice moving through an approval + payment lifecycle",
      "lifecycle_states": [
        "draft",
        "submitted",
        "approved",
        "partially_paid",
        "rejected",
        "disputed",
        "paid"
      ],
      "relationships": [
        {
          "field": "tenant_id",
          "target": "Tenant",
          "target_title": "Tenant",
          "required": true
        },
        {
          "field": "supplier",
          "target": "Supplier",
          "target_title": "Supplier",
          "required": true
        },
        {
          "field": "submitted_by",
          "target": "User",
          "target_title": "User",
          "required": false
        }
      ]
    },
    {
      "name": "LineItem",
      "title": "Line Item",
      "intent": "A single line on an invoice document — description + qty × unit amount",
      "lifecycle_states": [],
      "relationships": [
        {
          "field": "tenant_id",
          "target": "Tenant",
          "target_title": "Tenant",
          "required": true
        },
        {
          "field": "invoice",
          "target": "Invoice",
          "target_title": "Invoice",
          "required": true
        }
      ]
    },
    {
      "name": "InvoiceNote",
      "title": "Invoice Note",
      "intent": "Operator discussion on an Invoice — the conversation that drives approve, dispute, and pay",
      "lifecycle_states": [],
      "relationships": [
        {
          "field": "tenant_id",
          "target": "Tenant",
          "target_title": "Tenant",
          "required": true
        },
        {
          "field": "invoice",
          "target": "Invoice",
          "target_title": "Invoice",
          "required": true
        }
      ]
    },
    {
      "name": "PaymentAttempt",
      "title": "Payment Attempt",
      "intent": "One attempt to settle an approved invoice via the payment provider",
      "lifecycle_states": [
        "pending",
        "succeeded",
        "failed"
      ],
      "relationships": [
        {
          "field": "tenant_id",
          "target": "Tenant",
          "target_title": "Tenant",
          "required": true
        },
        {
          "field": "invoice",
          "target": "Invoice",
          "target_title": "Invoice",
          "required": true
        }
      ]
    }
  ],
