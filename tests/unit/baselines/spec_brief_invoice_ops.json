  "activated_claims": [
    {
      "id": "scope_filtering",
      "group": "security",
      "audience": "investor",
      "claim": "Access-controlled records are filtered to what each user is permitted\nto see. The rule is declared once in the model and applied automatically to every\nquery the framework runs, instead of being re-implemented — and re-checked — on\neach screen.",
      "evidence": "dazzle rbac report"
    },
    {
      "id": "database_rls",
      "group": "security",
      "audience": "investor",
      "claim": "Because the system shares tables across tenants, the per-tenant\nboundary is enforced inside PostgreSQL itself through row-level security policies.\nThe database refuses to return another tenant's rows even if the application code\nhas a bug, because the rule lives in the data layer, not the app.",
      "evidence": "dazzle db verify"
    },
    {
      "id": "provable_rbac",
      "group": "security",
      "audience": "investor",
      "claim": "Every role's permissions, for every entity and operation, are declared\nas machine-readable policy. They compile on demand into an auditable access\nmatrix — so permission review is something you run and diff, not something you\neyeball — and the row-visibility rules can additionally be submitted to an SMT\nsolver for formal verification.",
      "evidence": "dazzle rbac prove"
    },
    {
      "id": "multi_tenant",
      "group": "security",
      "audience": "founder",
      "claim": "The system is multi-tenant: each customer's data is isolated from every\nother customer's at the data layer, so one organisation cannot see another\norganisation's records.",
      "evidence": "dazzle tenant list"
    },
    {
      "id": "postgres_backed",
      "group": "data",
      "audience": "technical",
      "claim": "All data is stored in PostgreSQL — a mature, widely-trusted relational\ndatabase. There is no bespoke or experimental datastore to operate, secure, or\nreason about.",
      "evidence": "dazzle db status"
    },
    {
      "id": "schema_managed",
      "group": "data",
      "audience": "technical",
      "claim": "In production, every change to the data model is applied through\nversioned, reversible migrations. The live schema is never edited by hand, so\nupgrades are repeatable and fully auditable.",
      "evidence": "dazzle db status"
    },
    {
      "id": "server_rendered",
      "group": "architecture",
      "audience": "technical",
      "claim": "The interface is rendered on the server and progressively enhanced.\nThere is no heavy single-page JavaScript application to maintain, which keeps the\nproduct fast, accessible, and simple to operate.",
      "evidence": "dazzle validate"
    },
    {
      "id": "event_semantics",
      "group": "architecture",
      "audience": "technical",
      "claim": "Significant business moments are modelled as first-class events with\nformally-defined semantics, giving the system a precise, auditable record of what\nhappened and when.",
      "evidence": "dazzle specs asyncapi"
    },
    {
      "id": "background_execution",
      "group": "architecture",
      "audience": "technical",
      "claim": "Long-running and scheduled work is executed by a built-in background\nengine coordinated through the database itself — there is no separate queue\ninfrastructure to deploy or operate, and an interrupted run is picked up rather\nthan lost.",
      "evidence": "dazzle process list"
    },
    {
      "id": "approval_controls",
      "group": "security",
      "audience": "founder",
      "claim": "Sensitive changes require explicit sign-off: approval rules with named\napprover roles and quorums are part of the model itself, not an informal process\nthat depends on people remembering to ask.",
      "evidence": "dazzle validate"
    }
  ],
