  "journeys": [
    {
      "id": "ST-001",
      "title": "Approver works the awaiting-approval queue",
      "actor": "approver",
      "description": null,
      "when": [],
      "outcomes": [
        "Approver sees submitted invoices in the awaiting_approval queue sorted by amount",
        "Row open triple-hops Invoice via id | Supplier via supplier | User via submitted_by (invoice hub first, vendor then submitter)",
        "Approval load metrics show awaiting / approved / rejected counts"
      ]
    },
    {
      "id": "ST-002",
      "title": "Approver opens invoice hub before approve or reject",
      "actor": "approver",
      "description": null,
      "when": [],
      "outcomes": [
        "Invoice hub shows status strip, supplier, amount, and related line items as a pull queue",
        "Approver can transition to approved or rejected with reason"
      ]
    },
    {
      "id": "ST-003",
      "title": "Finance settles invoices from the ready-to-pay queue",
      "actor": "finance",
      "description": null,
      "when": [],
      "outcomes": [
        "Finance sees approved invoices in the ready_to_pay queue",
        "Opening a row triple-hops Invoice via id | Supplier via supplier | User via submitted_by; Invoice hub shows payment attempts as a pull queue"
      ]
    },
    {
      "id": "ST-004",
      "title": "Finance works the open dispute queue",
      "actor": "finance",
      "description": null,
      "when": [],
      "outcomes": [
        "Disputed queue surfaces invoices needing resolution",
        "Invoice hub shows dispute_reason and payment trail"
      ]
    },
    {
      "id": "ST-005",
      "title": "Requester reviews own invoices and line items via hub",
      "actor": "requester",
      "description": null,
      "when": [],
      "outcomes": [
        "Requester opens Invoice hub with related line items as a pull queue",
        "Requester can add line items and submit draft invoices",
        "Line item list triple-opens LineItem via id | Invoice via invoice | Tenant via tenant_id (line hub, parent invoice, tenant root)"
      ]
    },
    {
      "id": "ST-006",
      "title": "Auditor traces payment attempts back to the invoice hub",
      "actor": "auditor",
      "description": null,
      "when": [],
      "outcomes": [
        "Payment attempt rows triple-open PaymentAttempt via id | Invoice via invoice | Tenant via tenant_id (attempt hub first, invoice then tenant)",
        "Auditor cannot modify invoices or payments"
      ]
    }
  ],
