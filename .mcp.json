{
  "mcpServers": {
    "dazzle": {
      "type": "stdio",
      "command": "${CLAUDE_PROJECT_DIR:-/Volumes/SSD/Dazzle}/.venv/bin/python",
      "args": [
        "-m",
        "dazzle.mcp",
        "--working-dir",
        "${CLAUDE_PROJECT_DIR:-/Volumes/SSD/Dazzle}"
      ],
      "env": {}
    },
    "semgrep": {
      "type": "stdio",
      "command": "semgrep",
      "args": [
        "mcp",
        "--transport",
        "stdio"
      ]
    }
  }
}
